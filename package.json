{
  "name": "sydney-weekend-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/sw/generate.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "e2e": "playwright test",
    "lighthouse": "node scripts/perf/lighthouse.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:reset": "tsx scripts/db/reset.ts",
    "db:user": "tsx scripts/db/create-user.ts",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote && tsx scripts/db/refresh-derived.ts --remote && wrangler deploy --var CONTENT_MODE:published",
    "map:fetch": "node scripts/map/fetch-assets.mjs",
    "map:upload": "tsx scripts/map/upload.ts",
    "db:refresh": "tsx scripts/db/refresh-derived.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^7.0.0",
    "@date-fns/tz": "^1.5.0",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/react": "^2.0.1",
    "@protomaps/basemaps": "^5.7.2",
    "astro": "^7.3.5",
    "date-fns": "^4.4.0",
    "maplibre-gl": "^6.11.2",
    "nanostores": "^1.5.4",
    "pmtiles": "^4.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ical.js": "^2.2.1",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.145.0"
  }
}
