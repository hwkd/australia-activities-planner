---
import Base from "~/layouts/Base.astro";
import TabBar from "~/components/TabBar.astro";
import { SITE_NAME } from "~/site";
import { t } from "~/strings/en-AU";

const s = t.layout.notFound;
---

<Base title={s.title(SITE_NAME)}>
  <main class="mx-auto max-w-[560px] px-4 pt-10 pb-32">
    <p class="eb m-0" style="color: var(--sky-mute)">{s.eyebrow}</p>
    <h1 class="w90 tr mt-3.5 text-[46px] leading-[0.94] font-medium tracking-[-0.035em]" style="text-shadow: var(--hl)">{s.heading}</h1>
    <p class="tr mt-4 text-[15.5px]" style="color: var(--sky-mute)">{s.body}</p>
    <a href="/" class="pb press mt-6 no-underline" style="background: var(--sel); color: var(--sel-ink); border-color: var(--sel)">{s.back}</a>
  </main>
  <TabBar current="discover" />
</Base>
