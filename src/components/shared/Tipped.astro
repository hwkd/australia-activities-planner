---
import { tipParts } from "~/lib/tips";
import { t } from "~/strings/en-AU";

/**
 * Text that may end with an "Our tip:" sentence (spec §4.1): the tip gets a small "Our tip" label, so
 * visitors can tell our advice from facts an official source confirms.
 */
interface Props {
  text: string;
}
const parts = tipParts(Astro.props.text);
const s = t.detail.ourTip;
---

{parts.map((p, i) => (
  <>
    {i > 0 && " "}
    {p.tip ? (
      <span data-tip>
        <span class="tip-label" title={s.title}>
          {s.label}
          <span class="sr-only">{s.sr}</span>
        </span>{" "}
        {p.text}
      </span>
    ) : (
      p.text
    )}
  </>
))}
