---
import Tipped from "~/components/shared/Tipped.astro";
import { changesLabel, directionsHref, drivingNote, kindOf, lastStretch, minsLabel, wayIn, type Routes } from "~/lib/route";
import { tripFare } from "~/lib/cost";
import { legCss, legRail } from "~/theme/map-palette";
import { Icon } from "~/theme/icons";
import { t } from "~/strings/en-AU";

/**
 * Getting there (spec §3.2 item 4, D14): one public transport trip from the city centre, with the
 * way-in strip, the last stretch to the door, getting back, the Opal reminder, directions from where
 * the visitor is (Google Maps) and the Driving? note. Static: there's nothing to pick since D14.
 */
interface Props {
  routes: Routes;
}
const { routes } = Astro.props;
const s = t.detail.gettingThere;
const pt = routes.pt;
const way = wayIn(pt.legs);
const legs = lastStretch(pt.legs);
const fare = tripFare(pt);
const drive = drivingNote(routes);
---

<style is:global set:html={legCss()}></style>
<div class="mt-3 rounded-[20px] px-4 py-3.5" style="background: var(--soft); border: 1px solid var(--line)">
  <div class="flex items-end justify-between gap-3">
    <p class="m-0">
      <span class="k block" style="color: var(--mute)">{s.fromCity}</span>
      <span class="w80 mt-1.5 block text-[40px] leading-none font-extrabold tracking-[-0.04em]">{pt.total}</span>
    </p>
    <span class="shrink-0 rounded-full px-[11px] py-1.5 text-[12.5px] font-bold" style="border: 1px solid var(--line)">
      {changesLabel(pt.changes)}
    </span>
  </div>
  {
    way.length > 0 && (
      <p class="m-0 mt-3 flex flex-wrap items-center gap-1.5" data-way-in>
        <span class="sr-only">{s.wayIn}</span>
        {way.map((w, i) => (
          <>
            <span class="badge inline-flex items-center gap-1 py-[3px] pr-2 pl-1.5" style={`background: var(--leg-${w.kind}); color: var(--leg-ink)`}>
              <Icon name={w.kind} size={14} />
              <span class="sr-only">{s.legKind[w.mode]} </span>
              {w.label}
            </span>
            {i < way.length - 1 && (
              <span aria-hidden="true" style="color: var(--mute)">
                <Icon name="next" size={14} />
              </span>
            )}
          </>
        ))}
      </p>
    )
  }
  <p class="m-0 mt-3 pt-3 text-[15px] font-bold" style="border-top: 1px solid var(--line)">
    {fare.label}
    {fare.label !== t.lib.cost.free && <span class="ml-1 text-[12px] font-semibold" style="color: var(--mute)">{s.est}</span>}
  </p>
  <p class="m-0 mt-[3px] text-[12.5px] leading-[1.4]" style="color: var(--mute)">{fare.note}</p>
</div>

<h3 class="k mx-0.5 mt-[18px]" style="color: var(--mute)">{s.lastStretch}</h3>
<ol class="m-0 mt-3 list-none p-0">
  {
    legs.map((l, i) => {
      const k = kindOf(l.mode);
      return (
        <li class="leg-in flex gap-3" style={`animation-delay: ${i * 90}ms`}>
          <span class="flex w-9 shrink-0 flex-col items-center" aria-hidden="true">
            <span class="flex h-9 w-9 items-center justify-center rounded-full" style={`background: var(--leg-${k}); color: var(--leg-ink)`}>
              <Icon name={k} size={19} />
            </span>
            <span class="my-1 w-1 flex-1 rounded-sm" style={`background: ${legRail(k)}`} />
          </span>
          <span class="min-w-0 flex-1 pt-[7px] pb-[18px]">
            <span class="flex justify-between gap-2.5 text-[15px] leading-[1.3] font-[650]">
              <span>
                <span class="sr-only">{s.legPrefix(s.legKind[l.mode])}</span>
                {l.title}
              </span>
              <span class="shrink-0 text-[13.5px] font-bold" style="color: var(--mute)">
                {minsLabel(l.mins)}
              </span>
            </span>
            {(l.line || l.detail) && (
              <span class="mt-[5px] flex flex-wrap items-center gap-x-2 gap-y-1.5 text-[13px]" style="color: var(--mute)">
                {l.line && (
                  <span class="badge px-2 py-0.5" style={`background: var(--leg-${k}); color: var(--leg-ink)`}>
                    {l.line}
                  </span>
                )}
                {l.detail}
              </span>
            )}
          </span>
        </li>
      );
    })
  }
</ol>
<p class="leg-in m-0 flex items-center gap-3 text-[15px] font-bold" style={`animation-delay: ${legs.length * 90}ms`}>
  <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full" style="box-shadow: inset 0 0 0 2px var(--accent); color: var(--accent)">
    <Icon name="pin" size={18} strokeWidth={2.5} />
  </span>
  {s.arrive(routes.dest.label)}
</p>

{
  pt.back.text && (
    <div class="mt-4 flex gap-[11px] rounded-[18px] px-3.5 py-[13px]" style="background: var(--soft); border: 1px solid var(--line)">
      <Icon name="return" size={18} className="mt-px shrink-0" />
      <span>
        <span class="k block" style="color: var(--mute)">
          {s.gettingBack}
        </span>
        <span class="mt-[3px] block text-sm leading-[1.45]">{pt.back.text}</span>
      </span>
    </div>
  )
}

{
  way.length > 0 && (
    <p class="m-0 mt-3.5 flex items-center gap-2.5 px-0.5 text-[13.5px] font-semibold" style="color: var(--mute)">
      <Icon name="ticket" size={18} className="shrink-0" />
      {s.opal}
    </p>
  )
}

<a
  href={directionsHref(routes.dest)}
  target="_blank"
  rel="noopener noreferrer"
  class="press mt-3 flex min-h-[52px] items-center gap-3 rounded-2xl px-3.5 py-2 no-underline"
  style="background: var(--soft); border: 1px solid var(--line); color: inherit"
>
  <Icon name="pin" size={18} className="shrink-0" />
  <span class="flex-1">
    <span class="block text-[14.5px] font-bold">{s.directions}</span>
    <span class="mt-0.5 block text-[12.5px]" style="color: var(--mute)">{s.directionsNote}</span>
  </span>
  <Icon name="external" size={16} className="shrink-0" />
  <span class="sr-only">{t.detail.newTab}</span>
</a>

<div class="mt-3.5 rounded-[18px] p-3.5" style="border: 1px solid var(--line)">
  <h3 class="k flex items-center gap-2" style="color: var(--mute)">
    <Icon name="car" size={16} />
    {s.driving}
  </h3>
  {
    drive.canDrive ? (
      <>
        <p class="m-0 mt-2 text-[15px] font-bold">{s.driveTime(drive.time)}</p>
        <p class="m-0 mt-[3px] text-[13px]" style="color: var(--mute)">
          {drive.cost}
        </p>
        {drive.notes.length > 0 && (
          <ul class="m-0 mt-2 grid list-none gap-1.5 p-0">
            {drive.notes.map((n) => (
              <li class="flex gap-2.5 text-[13.5px] leading-[1.45]">
                <span style="color: var(--accent)">
                  <Icon name="bulb" size={16} className="mt-0.5 shrink-0" />
                </span>
                <span><Tipped text={n} /></span>
              </li>
            ))}
          </ul>
        )}
      </>
    ) : (
      <p class="m-0 mt-2 text-sm leading-[1.45]">{drive.reason}</p>
    )
  }
  {
    drive.ride && (
      <p class="m-0 mt-2.5 text-[13.5px] leading-[1.45]" data-ride>
        <span class="font-bold">{s.rideshare}</span>
        <span style="color: var(--mute)">{drive.ride}</span>
      </p>
    )
  }
</div>

<style>
  .k {
    margin: 0;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .badge {
    border-radius: 7px;
    font-size: 12px;
    font-weight: 800;
  }
</style>
