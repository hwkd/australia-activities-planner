---
import { t } from "~/strings/en-AU";

/**
 * Discover and My plans (spec §3). Phone: bottom tab bar. Desktop (≥ 1024 px): a pill in the top right.
 * Plain links; the current tab is known at build time. The count of plans coming up is filled in
 * before paint from storage, then kept up to date, so the switch never changes size after it shows.
 */
interface Props {
  current: "discover" | "plans";
}
const { current } = Astro.props;
---

<nav aria-label={t.layout.tabs.label} class="tabbar glass-strong">
  <a href="/" aria-current={current === "discover" ? "page" : undefined} class="press">
    <svg width="19" height="19" viewBox="0 0 24 24" class="ic" aria-hidden="true">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M15.5 8.5l-2 5-5 2 2-5z"></path>
    </svg>
    {t.layout.tabs.discover}
  </a>
  <a href="/plan" aria-current={current === "plans" ? "page" : undefined} class="press">
    <svg width="19" height="19" viewBox="0 0 24 24" class="ic" aria-hidden="true">
      <rect x="4" y="5" width="16" height="15" rx="2.5"></rect>
      <path d="M4 10h16M8.5 3v4M15.5 3v4"></path>
    </svg>
    {t.layout.tabs.plans}
    <span class="tab-badge" data-plan-badge hidden
      ><span data-n></span><span class="sr-only">{t.common.planBadge}</span></span
    >
  </a>
</nav>
<script is:inline>
  // Before paint (like the sky theme in Base.astro): the plans stay in this browser, so the HTML can't
  // carry the count, and filling it in after load made the switch grow and jump.
  (function () {
    const badge = document.querySelector("[data-plan-badge]");
    let n = 0;
    try {
      const p = Object.fromEntries(
        new Intl.DateTimeFormat("en-AU", { timeZone: "Australia/Sydney", year: "numeric", month: "2-digit", day: "2-digit" })
          .formatToParts(new Date())
          .map(function (x) { return [x.type, x.value]; }),
      );
      const today = p.year + "-" + p.month + "-" + p.day;
      const days = JSON.parse(localStorage.getItem("swf.plan.v2") || "{}").days || {};
      for (const d in days) if (d >= today && Array.isArray(days[d].items)) n += days[d].items.length;
    } catch {
      /* storage blocked or unreadable: the script below fills it in */
    }
    if (n > 0) {
      badge.querySelector("[data-n]").textContent = n;
      badge.hidden = false;
    }
  })();
</script>
<script>
  // Then follow the plan as it changes (here, in a sheet, or in another tab).
  import { $plan } from "~/stores/plan";
  import { todayInSydney } from "~/lib/dates";

  const badge = document.querySelector<HTMLElement>("[data-plan-badge]");
  if (badge) {
    $plan.subscribe((plan) => {
      const today = todayInSydney();
      const n = Object.entries(plan.days)
        .filter(([d]) => d >= today)
        .reduce((sum, [, e]) => sum + e.items.length, 0);
      badge.querySelector("[data-n]")!.textContent = String(n);
      badge.hidden = n === 0;
    });
  }
</script>

<style>
  .tabbar {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 10;
    height: 68px;
    max-width: 528px;
    margin: 0 auto;
    padding: 6px;
    box-sizing: border-box;
    border-radius: 26px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }
  .tabbar a {
    border-radius: 20px;
    color: var(--ink);
    font-size: 14.5px;
    font-weight: 700;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .tabbar a[aria-current="page"] {
    background: var(--sel);
    color: var(--sel-ink);
  }
  .tab-badge {
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    box-sizing: border-box;
    border-radius: 999px;
    background: var(--sel);
    color: var(--sel-ink);
    font-size: 12px;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .tab-badge[hidden] {
    display: none;
  }
  .tabbar a[aria-current="page"] .tab-badge {
    background: var(--sel-ink);
    color: var(--sel);
  }
  @media (min-width: 1024px) {
    .tabbar {
      left: auto;
      /* A page whose content is narrower than the window sets --tabbar-right to line up with it. */
      right: var(--tabbar-right, 24px);
      top: 24px;
      bottom: auto;
      width: auto;
      height: 54px;
      max-width: none;
      margin: 0;
      padding: 4px;
      border-radius: 999px;
      display: flex;
      gap: 4px;
    }
    .tabbar a {
      padding: 0 18px;
      border-radius: 999px;
    }
  }
</style>
